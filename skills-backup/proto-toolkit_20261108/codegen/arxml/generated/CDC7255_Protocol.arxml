              <SHORT-NAME>StrStateFbMtd</SHORT-NAME>
              <DESC>
                <L-2 L="EN">msg_id=0x0106; direction=SOC_TO_MCU; type=event; tx_type=event; transport=spi&amp;uart; qos=</L-2>
                <L-2 L="ZH">STR 状态反馈</L-2>
              </DESC>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>STRState</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">io=IN</L-2>
                    <L-2 L="ZH">STR状态</L-2>
                  </DESC>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/CDC7255/DataTypes/STR_STATE</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>StrDebugSetMtd</SHORT-NAME>
              <DESC>
                <L-2 L="EN">pair_id=0x811E; msg_id=0x011E; direction=SOC_TO_MCU; type=method(rr); tx_type=event; transport=spi&amp;uart; qos=</L-2>
                <L-2 L="ZH">SoC 向 MCU 通知 STR 最大维持时长</L-2>
              </DESC>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
