                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>StrMaxDuration</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">io=IN</L-2>
                      </DESC>
                      <TYPE-TREF DEST="APPLICATION-RECORD-DATA-TYPE">/CDC7255/DataTypes/StrMaxDuration</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
            </CLIENT-SERVER-INTERFACE>
