                  </DESC>
                  <TYPE-TREF DEST="APPLICATION-RECORD-DATA-TYPE">/CDC7255/DataTypes/DateTime</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
          </ELEMENTS>
