              <SHORT-NAME>TimeSetEvt</SHORT-NAME>
              <DESC>
                <L-2 L="EN">msg_id=0x0D02; direction=SOC_TO_MCU; type=event; tx_type=event; transport=uart; qos=level1</L-2>
