              <DESC>
                <L-2 L="EN">pair_id=0x8D01; msg_id=0x0D01; direction=SOC_TO_MCU; type=method(rr); tx_type=event; transport=uart; qos=level1</L-2>
                <L-2 L="ZH">SoC 查询 MCU 当前时间</L-2>
