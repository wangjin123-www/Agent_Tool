              </DESC>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>DateTime</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">io=OUT</L-2>
