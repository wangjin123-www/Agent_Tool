        <AR-PACKAGE>
          <SHORT-NAME>Interfaces</SHORT-NAME>
          <ELEMENTS>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>PowerOnHandshakeMtd</SHORT-NAME>
              <DESC>
                <L-2 L="EN">pair_id=0x8100; msg_id=0x0100; direction=SOC_TO_MCU; type=event; tx_type=event; transport=spi&amp;uart; qos=</L-2>
                <L-2 L="ZH">上电握手：SoC 启动后首先发送本命令与 MCU 建立通讯握手
1 秒内未收到 0x8100 需重发，握手成功后停放</L-2>
              </DESC>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>MPURequestsDataSynchronization</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">io=NONE</L-2>
                    <L-2 L="ZH">MPU请求数据同步</L-2>
                  </DESC>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/CDC7255/DataTypes/MPU_REQ_DATA_SYNC</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>PowerOffReqMtd</SHORT-NAME>
              <DESC>
                <L-2 L="EN">pair_id=0x8101; msg_id=0x0101; direction=SOC_TO_MCU; type=method(rr); tx_type=event; transport=spi&amp;uart; qos=</L-2>
                <L-2 L="ZH">SoC 主动向 MCU 请求睡眠或关机</L-2>
              </DESC>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>PowerOffReqMtd</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>PowerReqCmd</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">io=IN</L-2>
                        <L-2 L="ZH">电源请求命令</L-2>
                      </DESC>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/CDC7255/DataTypes/POWER_REQ_CMD</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
            </CLIENT-SERVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>HeartbeatSetMtd</SHORT-NAME>
              <DESC>
                <L-2 L="EN">pair_id=0x8102; msg_id=0x0102; direction=SOC_TO_MCU; type=method(rr); tx_type=event; transport=spi&amp;uart; qos=</L-2>
                <L-2 L="ZH">心跳设置下发：开启/关闭 Comm UART 或 Fast UART 心跳</L-2>
              </DESC>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>HeartbeatSetMtd</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>HeartbeatSet</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">io=IN</L-2>
                        <L-2 L="ZH">心跳设置状态</L-2>
                      </DESC>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/CDC7255/DataTypes/HEARTBEAT_SET</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
            </CLIENT-SERVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>HeartbeatReqMtd</SHORT-NAME>
              <DESC>
                <L-2 L="EN">pair_id=0x8103; msg_id=0x0103; direction=SOC_TO_MCU; type=event; tx_type=Cycle(1000ms); transport=spi&amp;uart; qos=</L-2>
                <L-2 L="ZH">心跳请求：周期 1000ms 发送；握手后默认开启心跳</L-2>
              </DESC>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>HeartbeatState</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">io=IN</L-2>
                    <L-2 L="ZH">心跳状态</L-2>
                  </DESC>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/CDC7255/DataTypes/HEARTBEAT_STATE</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>PowerMgmtReqMtd</SHORT-NAME>
              <DESC>
                <L-2 L="EN">pair_id=0x8105; msg_id=0x0105; direction=SOC_TO_MCU; type=method(rr); tx_type=event; transport=spi&amp;uart; qos=</L-2>
                <L-2 L="ZH">SoC 主动查询 MCU 的电源状态</L-2>
              </DESC>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>PowerMgmtReqMtd</SHORT-NAME>
                </CLIENT-SERVER-OPERATION>
