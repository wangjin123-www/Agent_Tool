                  <TYPE-TREF DEST="APPLICATION-RECORD-DATA-TYPE">/CDC7255/DataTypes/DateTime</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>TimeUploadEvt</SHORT-NAME>
              <DESC>
                <L-2 L="EN">msg_id=0x8D02; direction=MCU_TO_SOC; type=event; tx_type=Cycle(60000ms); transport=uart; qos=level1</L-2>
                <L-2 L="ZH">MCU 每 1min 主动上传当前时间</L-2>
