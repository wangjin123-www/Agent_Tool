{% for s in structs if not s.is_raw %}
/* {{ s.name }}: {{ s.desc }} 大端 Pack（返回写入字节数） */
uint16_t {{ s.fname }}_Pack(const {{ s.c_name }} *p, uint8_t *buf)
{
    uint16_t i = 0u;
{% for m in s.members %}
{% if m.open %}
    /* {{ m.name }}: 开放尾由调用方追加，此处不写 */
{% elif m.ctype == 'uint8_t' %}
    buf[i] = p->{{ m.name }}; i++;
{% elif m.ctype == 'uint16_t' %}
    buf[i] = (uint8_t)(p->{{ m.name }} >> 8); i++;
    buf[i] = (uint8_t)(p->{{ m.name }}); i++;
{% elif m.ctype == 'uint32_t' %}
    buf[i] = (uint8_t)(p->{{ m.name }} >> 24); i++;
    buf[i] = (uint8_t)(p->{{ m.name }} >> 16); i++;
    buf[i] = (uint8_t)(p->{{ m.name }} >> 8); i++;
    buf[i] = (uint8_t)(p->{{ m.name }}); i++;
{% endif %}
{% endfor %}
    return i;
}

void {{ s.fname }}_Unpack({{ s.c_name }} *p, const uint8_t *buf)
{
    uint16_t i = 0u;
{% for m in s.members %}
{% if m.open %}
    /* {{ m.name }}: 开放尾由调用方按帧长拷贝 */
{% elif m.ctype == 'uint8_t' %}
    p->{{ m.name }} = buf[i]; i++;
{% elif m.ctype == 'uint16_t' %}
    p->{{ m.name }} = (uint16_t)(((uint16_t)buf[i] << 8) | buf[i + 1u]); i += 2u;
{% elif m.ctype == 'uint32_t' %}
    p->{{ m.name }} = ((uint32_t)buf[i] << 24) | ((uint32_t)buf[i + 1u] << 16) \
                    | ((uint32_t)buf[i + 2u] << 8) | buf[i + 3u]; i += 4u;
{% endif %}
{% endfor %}
}

