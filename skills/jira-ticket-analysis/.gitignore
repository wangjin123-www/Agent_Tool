# ---------------------------------------------------------------- 环境
# 虚拟环境不随包分发，解压后按 requirements.txt 重建（DLP 会污染 venv 内的包，见 README）
.venv/

# ---------------------------------------------------------------- 运行时产物
# 工作区：代码快照、CLAUDE.md 缓存、工单产物、水位 state.json —— 全是可再生数据
workspace/

# ---------------------------------------------------------------- 凭据 / 本机配置（绝不提交）
# 工具根 config.json：含本机工程描述、仓库地址、收件邮箱，属本机配置，不进版本库
/config.json
# Jira PAT（vendor 的 jira-tool 从这里读；也可改用环境变量 JIRA_PAT）
vendor/jira-tool/scripts/config.json
# 机器相关的 vendor 源路径映射（含本机绝对路径）
vendor/sources.json

# ---------------------------------------------------------------- 大文件
# lark-cli.exe 49MB，用户按需手动放入，不进版本库也不进分发包
vendor/lark-cli/*.exe

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------- 分发包
dist/
*.zip
